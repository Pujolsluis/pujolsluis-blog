{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pujolsluis.com/migration/v1/assets.schema.json",
  "title": "Migration assets v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._-]+$"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "localPath": {
            "type": "string",
            "pattern": "^(?!/|.*(?:\\.{2}|[?#\\\\]))[^:]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "mimeType": {
            "type": "string",
            "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "owned": {
            "type": "boolean"
          }
        },
        "required": [
          "assetId",
          "sourceUrl",
          "localPath",
          "sha256",
          "bytes",
          "mimeType",
          "width",
          "height",
          "owned"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "assets"
  ]
}
