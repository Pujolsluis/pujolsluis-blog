{{- $pages := where site.RegularPages "Section" "posts" -}}
{{- $pages = first 50 $pages.ByDate.Reverse -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0"><channel>
  <title>{{ site.Title }}</title><link>{{ site.Home.Permalink }}</link><description>{{ site.Params.description }}</description><language>{{ site.Language.Lang }}</language>
  {{ range $pages }}<item>
    <title>{{ .Title }}</title><link>{{ .Permalink }}</link>
    <guid isPermaLink="false">{{ .Params.guid | default .Permalink }}</guid>
    <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
    <description>{{ .Params.excerpt | default .Summary | plainify | html }}</description>
  </item>{{ end }}
</channel></rss>
